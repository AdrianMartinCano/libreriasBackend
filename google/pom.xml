<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.adrianmartincano</groupId>
    <artifactId>libs-parent</artifactId>
    <version>0.12.5</version>
  </parent>
  <artifactId>spring-google</artifactId>
  <name>Spring Google</name>
  <description>Entrar con Google (Google Identity Services): verifica el id_token, vincula o crea la cuenta y devuelve el mismo JWT que el login normal.</description>
  <dependencies>
    <dependency>
      <groupId>io.github.adrianmartincano</groupId>
      <artifactId>spring-common</artifactId>
    </dependency>
    <!-- Emite la sesion: JwtTokenProvider y LoginResponse, los mismos que el login normal -->
    <dependency>
      <groupId>io.github.adrianmartincano</groupId>
      <artifactId>spring-security</artifactId>
    </dependency>
    <!-- AppUser y UserRepository: la cuenta que se vincula o se crea -->
    <dependency>
      <groupId>io.github.adrianmartincano</groupId>
      <artifactId>spring-users</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      Nimbus, y NO google-api-client: pesa muchisimo menos y es lo que ya usa Spring
      Security para decodificar JWT. Refresca solo las claves publicas cuando Google las
      rota, que es la parte que de verdad hay que acertar.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>